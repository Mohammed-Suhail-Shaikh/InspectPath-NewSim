# Copy to api/.env and fill in. Never commit api/.env.
# Server-side LLM credential. No VITE_ prefix: this never reaches the browser.
GEMINI_API_KEY=
# Optional overrides:
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated list of allowed frontend origins (CORS).
INSPECTPATH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
