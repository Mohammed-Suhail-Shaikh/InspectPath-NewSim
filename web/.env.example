# Copy to .env and fill in. Never commit .env.
# These are URLs/paths, not secrets.

# Base URL of the InspectPath API (report backend). Default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Where the shared data/ outputs are served from (replay, structures, image_map).
# The app uses the real source when these files exist, otherwise falls back to mocks.
# Default: /data
VITE_DATA_BASE_URL=/data

# Defect model endpoint (POST /predict, contract §1). Default: http://localhost:8001
VITE_PREDICT_URL=http://localhost:8001
